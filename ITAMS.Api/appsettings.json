{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "RateLimits": {
    "LoginPerMinute": 5,
    "ApiPerMinute": 120
  },

  "Jwt": {
    "Issuer": "itams",
    "Audience": "itams-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "Key": ""
  }
}
