{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "RateLimits": {
    "LoginPerMinute": 5,
    "ApiPerMinute": 120,
    "PublicReportPer10Minutes": 30
  },

  "Session": {
    "MaxHours": 12,
    "OwnerMaxHours": 8,
    "ValidationCacheSeconds": 5
  },

  "Jwt": {
    "Issuer": "itams",
    "Audience": "itams-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "Key": ""
  }
}
